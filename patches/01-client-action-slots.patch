+/// Deviation, for a crate on top (a gamepad addon's own bar): Lua action ids 121-256 are
+/// client-only slots past the reference's 120. They work like any slot (icon, range, usable,
+/// cooldown, `UseAction`, `PickupAction`/`PlaceAction`) but never reach the server, so the
+/// addon keeps them itself: `SetClientAction(id, kind, action)` writes one (no kind clears it)
+/// and `GetClientAction(id)` reads any slot's `kind, action`.
+pub(crate) const CLIENT_ACTION_FIRST: u32 = 121;
+/// The last client-only Lua action id: the wire slot index is a byte.
+pub(crate) const CLIENT_ACTION_LAST: u32 = 256;
+
 /// What one action slot shows; the app resolves the icon before pushing.
 #[derive(Clone, Debug, Default, PartialEq)]
