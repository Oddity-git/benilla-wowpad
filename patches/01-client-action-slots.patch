+    /// The client-only slots write and read like any slot, queue their write for the app, and
+    /// refuse the server's 120.
+    #[test]
+    fn a_client_action_is_stored_read_back_and_cleared() {
+        let mut s = UiScript::new().unwrap();
+        assert!(s
+            .eval::<bool>("return SetClientAction(121, 0, 133)")
+            .unwrap());
+        assert!(s.eval::<bool>("return HasAction(121) == 1").unwrap());
+        let (kind, action): (u8, u32) = s.eval("return GetClientAction(121)").unwrap();
+        assert_eq!((kind, action), (0, 133));
+        assert!(!s
+            .eval::<bool>("return SetClientAction(120, 0, 133)")
+            .unwrap());
+        assert!(s.eval::<bool>("return SetClientAction(121)").unwrap());
+        assert!(s.eval::<bool>("return HasAction(121) == nil").unwrap());
+        assert_eq!(s.take_action_sets(), vec![(121, 133), (121, 0)]);
+    }
