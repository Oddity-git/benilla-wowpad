     let g = lua.globals();
 
+    // The client-only slots' store, for the addon that owns them (see `CLIENT_ACTION_FIRST`).
+    g.set(
+        "SetClientAction",
+        lua.create_function(|lua, (id, kind, action): (u32, Option<u8>, Option<u32>)| {
+            if !(CLIENT_ACTION_FIRST..=CLIENT_ACTION_LAST).contains(&id) {
+                return Ok(false);
+            }
+            let mut model = lua.app_data_mut::<Model>().expect("model app_data");
+            match kind.zip(action) {
+                Some((kind, action)) => {
+                    let action = action & 0x00FF_FFFF;
+                    model.actions.insert(
