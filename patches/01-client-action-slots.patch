+                        ActionSlot {
+                            kind,
+                            action,
+                            ..ActionSlot::default()
+                        },
+                    );
+                    model
+                        .action_sets
+                        .push((id, (u32::from(kind) << 24) | action));
+                }
+                None => {
+                    model.actions.remove(&id);
+                    model.action_sets.push((id, 0));
+                }
+            }
+            Ok(true)
+        })?,
+    )?;
