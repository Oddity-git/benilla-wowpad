diff --git a/crates/benilla-app/src/held_items.rs b/crates/benilla-app/src/held_items.rs
new file mode 100644
index 000000000..2dc3fcdea
--- /dev/null
+++ b/crates/benilla-app/src/held_items.rs
@@ -0,0 +1,62 @@
+//! Deviation (for crates on top, as benilla-wowpad): the facts about a held item that say where
+//! its use works, which 1.12.1's interface has no call for. The client already holds each one:
+//! the item template's zone and map binding, the use spell's `RequiresSpellFocus`, and a spell
+//! focus object's focus id and radius.
+
+use bevy::ecs::system::SystemParam;
+use bevy::prelude::*;
+
+pub use benilla_protocol::messages::ItemInfo;
+
+use crate::area::AreaTableRes;
+use crate::go_templates::GameObjectTemplates;
+use crate::items::Items;
+use crate::query_cache::Ask;
+use crate::ui_action::Spells;
+
+/// Read-only lookups into the item, spell, game object and area caches. Nothing here asks the
+/// server: a template not yet cached reads `None`.
+#[derive(SystemParam)]
+pub struct HeldItemFacts<'w> {
+    items: Option<Res<'w, Items>>,
+    spells: Option<Res<'w, Spells>>,
+    objects: Option<Res<'w, GameObjectTemplates>>,
+    areas: Option<Res<'w, AreaTableRes>>,
+}
+
+impl HeldItemFacts<'_> {
+    /// The cached item template for `entry`.
+    pub fn template(&self, entry: u32) -> Option<&ItemInfo> {
+        self.items.as_ref()?.template(entry, 0, Ask::Read)
+    }
+
+    /// `SpellFocusObject.dbc` id a spell needs nearby; 0 for none or an unknown spell.
+    pub fn spell_focus(&self, spell: u32) -> u32 {
+        self.spells
+            .as_ref()
+            .and_then(|s| s.catalog.get(spell))
+            .map_or(0, |d| d.requires_spell_focus)
+    }
+
+    /// A spell's tooltip text (`Spell.dbc` description), its `$` tokens unexpanded.
+    pub fn spell_description(&self, spell: u32) -> Option<&str> {
+        self.spells.as_ref()?.catalog.get(spell)?.description.as_deref()
+    }
+
+    /// A spell focus object's `(focus id, radius in yards)` by its entry, once its template is
+    /// cached.
+    pub fn object_spell_focus(&self, entry: u32) -> Option<(u32, f32)> {
+        self.objects.as_ref()?.spell_focus(entry)
+    }
+
+    /// A game object's name by its entry, once its template is cached.
+    pub fn object_name(&self, entry: u32) -> Option<&str> {
+        self.objects.as_ref()?.name(entry)
+    }
+
+    /// The zone an `AreaTable` id lies in: the area itself for a zone, else its parent.
+    pub fn zone_of(&self, area: u32) -> Option<u32> {
+        let row = self.areas.as_ref()?.0.get(area)?;
+        Some(if row.zone_id == 0 { area } else { row.zone_id })
+    }
+}
